# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Replicate API
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# Seedream Model Version
# NOTE: bytedance/seedream is not publicly available on Replicate
# Use one of these alternatives:

# Option 1: FLUX Dev LoRA (Recommended for headshots)
SEEDREAM_MODEL_VERSION=lucataco/flux-dev-lora:a22c463f11808638ad5e2ebd582e07a469031f48dd567366fb4c6fdab91d614d

# Option 2: Stable Diffusion XL
# SEEDREAM_MODEL_VERSION=stability-ai/sdxl:39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b

# Option 3: Find another model at https://replicate.com/explore
# SEEDREAM_MODEL_VERSION=owner/model:version-hash

# Webhook Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REPLICATE_WEBHOOK_SECRET=your-webhook-secret-here

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here
