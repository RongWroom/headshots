# RunPod Configuration for ComfyUI Headshot Generator
# Copy this file to your application's .env.local and fill in the values

# ============================================
# RunPod Endpoint Configuration
# ============================================

# Your RunPod endpoint ID (found in RunPod dashboard)
# Example: abc123xyz456
RUNPOD_ENDPOINT_ID=

# Your RunPod API key (generate in RunPod Settings → API Keys)
# Keep this secret! Never commit to git.
RUNPOD_API_KEY=

# Webhook secret for validating callbacks from RunPod
# Generate with: openssl rand -hex 32
# Must match the WEBHOOK_SECRET set in RunPod endpoint environment variables
RUNPOD_WEBHOOK_SECRET=

# ============================================
# Optional Configuration
# ============================================

# RunPod API base URL (usually don't need to change)
RUNPOD_API_URL=https://api.runpod.ai/v2

# Maximum time to wait for generation (seconds)
# Default: 600 (10 minutes)
RUNPOD_TIMEOUT=600

# Number of retries for failed requests
# Default: 3
RUNPOD_MAX_RETRIES=3

# Polling interval for status checks (milliseconds)
# Default: 2000 (2 seconds)
RUNPOD_POLL_INTERVAL=2000

# ============================================
# DanDan LoRA Configuration
# ============================================

# URL to the DanDan LoRA model
# This should match the DANDAN_LORA_URL in RunPod endpoint
DANDAN_LORA_URL=

# Default style intensity (0-1)
# Default: 0.8
DEFAULT_STYLE_INTENSITY=0.8

# ============================================
# Generation Defaults
# ============================================

# Default number of output images
# Default: 4
DEFAULT_NUM_OUTPUTS=4

# Minimum reference images required
# Default: 5
MIN_REFERENCE_IMAGES=5

# Maximum reference images allowed
# Default: 10
MAX_REFERENCE_IMAGES=10

# ============================================
# Cost Tracking (Optional)
# ============================================

# Enable cost tracking
ENABLE_COST_TRACKING=true

# Estimated cost per generation (USD)
# Update based on actual usage
COST_PER_GENERATION=0.02

# ============================================
# Monitoring and Logging (Optional)
# ============================================

# Enable detailed logging
ENABLE_DETAILED_LOGGING=true

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable webhook logging
LOG_WEBHOOKS=true

# ============================================
# Notes
# ============================================

# 1. Never commit this file with real values to git
# 2. Keep API keys and secrets secure
# 3. Rotate secrets regularly (every 90 days)
# 4. Monitor costs in RunPod dashboard
# 5. Set up billing alerts in RunPod

# ============================================
# Quick Start
# ============================================

# 1. Copy this file to your application root:
#    cp runpod-comfyui-headshots/.env.runpod.example .env.local

# 2. Fill in the required values:
#    - RUNPOD_ENDPOINT_ID
#    - RUNPOD_API_KEY
#    - RUNPOD_WEBHOOK_SECRET

# 3. Restart your application

# 4. Test with a sample generation

